# Ambiente Python
.venv/
__pycache__/
*.pyc

# Sistema
.DS_Store

# Logs de teste de carga (locais, não fazem parte do código publicado)
logs/

# Saídas geradas pelo pipeline (EPUB/AZW3 de teste)
saida/

# Amostras de PDF com direito autoral ou dados pessoais.
# Regra específica, não "*.pdf" genérico: um PDF de exemplo pequeno e
# livre de direitos autorais pode ser versionado no futuro para
# documentação de uso (ver ARCHITECTURE.md/README.md).
samples/*.pdf
samples/CV_*

# PyInstaller (artefatos de build do sidecar — gerados por
# scripts/build-sidecar.sh, não versionados; ver ARCHITECTURE.md Fase 4)
build/
dist/
foliant-core.spec

# App desktop Tauri
desktop/node_modules/
desktop/src-tauri/target/
desktop/src-tauri/binaries/
desktop/src-tauri/gen/
