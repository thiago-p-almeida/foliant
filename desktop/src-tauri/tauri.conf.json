{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Foliant",
  "version": "0.2.0",
  "identifier": "com.foliant.app",
  "build": {
    "frontendDist": "../dist",
    "beforeDevCommand": "pnpm build:web",
    "beforeBuildCommand": "pnpm build:web"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Foliant",
        "width": 800,
        "height": 700
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "externalBin": ["binaries/foliant-core", "binaries/foliant-core-inspect"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDM2RDUyNjYyRDBGNTkzNTYKUldSV2svWFFZaWJWTnQ4MGFQRGpWd0dzMk0xUTk0Q2RLdWJYT2ZhUFF2bWxrQ3hPZ3ovYkp1MS8K",
      "endpoints": [
        "https://github.com/thiago-p-almeida/foliant/releases/latest/download/latest.json"
      ]
    }
  }
}
