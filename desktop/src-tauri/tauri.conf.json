{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Foliant",
  "version": "0.1.0",
  "identifier": "com.foliant.app",
  "build": {
    "frontendDist": "../dist",
    "beforeDevCommand": "pnpm build:web",
    "beforeBuildCommand": "pnpm build:web"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Foliant",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": ["binaries/foliant-core"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
