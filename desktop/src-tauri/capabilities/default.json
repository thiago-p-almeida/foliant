{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:default",
    "dialog:default",
    "updater:default",
    "process:allow-restart",
    {
      "identifier": "shell:allow-spawn",
      "allow": [
        {
          "name": "binaries/foliant-core",
          "sidecar": true,
          "args": [
            { "validator": ".+" },
            { "validator": ".+" },
            "--lang",
            { "validator": ".+" },
            "--autor",
            { "validator": ".+" },
            "--titulo",
            { "validator": ".*" }
          ]
        },
        {
          "name": "binaries/foliant-core-inspect",
          "sidecar": true,
          "args": [{ "validator": ".+" }, "--inspect"]
        }
      ]
    }
  ]
}
