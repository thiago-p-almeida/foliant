{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "assets/icons/**",
              "components/chrome/**",
              "components/core/**",
              "components/feedback/**",
              "components/forms/**",
              "ui_kits/foliant-app/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Inter))/i]",
        "message": "Font not provided by the design system. Available: Inter."
      },
      {
        "selector": "JSXOpeningElement[name.name='AppWindow'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|badge|children|width|style|key|ref|className|style|children)$/]",
        "message": "<AppWindow> doesn't accept that prop. Declared props: title, badge, children, width, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|variant|size|icon|iconEnd|fullWidth|disabled|as|onClick|style|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: children, variant, size, icon, iconEnd, fullWidth, disabled, as, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|ghost|success)$/]",
        "message": "<Button> variant must be one of 'primary' | 'secondary' | 'ghost' | 'success'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='as'] > Literal[value!=/^(?:button|a)$/]",
        "message": "<Button> as must be one of 'button' | 'a'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Callout'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|title|children|icon|actions|style|key|ref|className|style|children)$/]",
        "message": "<Callout> doesn't accept that prop. Declared props: tone, title, children, icon, actions, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Callout'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:info|warning|success|error)$/]",
        "message": "<Callout> tone must be one of 'info' | 'warning' | 'success' | 'error'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|surface|padding|radius|bordered|elevated|style|key|ref|className|style|children)$/]",
        "message": "<Card> doesn't accept that prop. Declared props: children, surface, padding, radius, bordered, elevated, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute[name.name='surface'] > Literal[value!=/^(?:card|sunken|plain|brandTint)$/]",
        "message": "<Card> surface must be one of 'card' | 'sunken' | 'plain' | 'brandTint'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Checkbox'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|help|checked|onChange|id|style|key|ref|className|style|children)$/]",
        "message": "<Checkbox> doesn't accept that prop. Declared props: label, help, checked, onChange, id, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Disclosure'] > JSXAttribute > JSXIdentifier[name!=/^(?:summary|children|open|defaultOpen|surface|style|key|ref|className|style|children)$/]",
        "message": "<Disclosure> doesn't accept that prop. Declared props: summary, children, open, defaultOpen, surface, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Disclosure'] > JSXAttribute[name.name='surface'] > Literal[value!=/^(?:sunken|card|plain)$/]",
        "message": "<Disclosure> surface must be one of 'sunken' | 'card' | 'plain'."
      },
      {
        "selector": "JSXOpeningElement[name.name='DropZone'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|hint|action|note|active|onActivate|style|key|ref|className|style|children)$/]",
        "message": "<DropZone> doesn't accept that prop. Declared props: title, hint, action, note, active, onActivate, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='FileSummary'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|meta|action|style|key|ref|className|style|children)$/]",
        "message": "<FileSummary> doesn't accept that prop. Declared props: name, meta, action, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|color|style|key|ref|className|style|children)$/]",
        "message": "<Icon> doesn't accept that prop. Declared props: name, size, color, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='LocalBadge'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|style|key|ref|className|style|children)$/]",
        "message": "<LocalBadge> doesn't accept that prop. Declared props: children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProgressPhase'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|counter|percent|state|indeterminate|style|key|ref|className|style|children)$/]",
        "message": "<ProgressPhase> doesn't accept that prop. Declared props: label, counter, percent, state, indeterminate, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProgressPhase'] > JSXAttribute[name.name='state'] > Literal[value!=/^(?:pending|active|done)$/]",
        "message": "<ProgressPhase> state must be one of 'pending' | 'active' | 'done'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SegmentedControl'] > JSXAttribute > JSXIdentifier[name!=/^(?:options|value|onChange|label|style|key|ref|className|style|children)$/]",
        "message": "<SegmentedControl> doesn't accept that prop. Declared props: options, value, onChange, label, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Tag'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|tone|icon|style|key|ref|className|style|children)$/]",
        "message": "<Tag> doesn't accept that prop. Declared props: children, tone, icon, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Tag'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:neutral|brand|success|warning|error)$/]",
        "message": "<Tag> tone must be one of 'neutral' | 'brand' | 'success' | 'warning' | 'error'."
      },
      {
        "selector": "JSXOpeningElement[name.name='TextField'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|help|value|placeholder|type|readOnly|invalid|id|action|style|key|ref|className|style|children)$/]",
        "message": "<TextField> doesn't accept that prop. Declared props: label, help, value, placeholder, type, readOnly, invalid, id, action, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='TextField'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:text|search)$/]",
        "message": "<TextField> type must be one of 'text' | 'search'."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
